NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Public frontend origin: CORS, password-reset links and the email logo use it.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins (comma separated, wildcards such as https://*.vercel.app work).
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker replica set from docker-compose.db.yml. Atlas replica sets also work.
MONGO_URI=mongodb://127.0.0.1:27018/docduniya?replicaSet=rs0&directConnection=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# lax | strict | none (none only for a cross-site frontend over HTTPS)
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
# Google Identity Services web client ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Used only by `npm run admin:create`.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe@123

# ── Email ─────────────────────────────────────────────────────────────────────
VERIFY_SMTP_ON_START=true
# true = refuse to start when SMTP is unreachable.
EMAIL_REQUIRED_ON_START=false
# titan | gmail | microsoft | zoho | godaddy | smtp (custom server: set EMAIL_SMTP_*)
EMAIL_PROVIDER=titan
EMAIL_USERNAME=no-reply@example.com
EMAIL_PASSWORD=
EMAIL_SMTP_POOL=true
EMAIL_SMTP_MAX_CONNECTIONS=5
EMAIL_SMTP_MAX_MESSAGES=100
# Brand name shown as the sender name and inside templates.
EMAIL_COMPANY_NAME=DocDuniya
EMAIL_FROM=no-reply@example.com
# Optional per-purpose senders (fall back to EMAIL_FROM).
EMAIL_AUTH_FROM=
EMAIL_TEAM_FROM=
# Optional absolute logo URL (defaults to FRONTEND_URL/brand/email-logo.png).
EMAIL_LOGO_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# ── Storage (Amazon S3) ───────────────────────────────────────────────────────
STORAGE_DEFAULT_VISIBILITY=private
STORAGE_UPLOAD_CONCURRENCY=4
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public CDN / bucket base URL without trailing slash.
AWS_CDN_URL=
# S3-compatible endpoints (MinIO etc.) only.
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
# Media-library upload limits (capped at 500 MB).
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=10

# ── Private clinical documents ────────────────────────────────────────────────
# A dedicated private bucket; never the public media bucket above.
PRIVATE_DOCUMENTS_BUCKET=
PRIVATE_DOCUMENTS_REGION=ap-south-1
PRIVATE_DOCUMENT_MAX_MB=20
# ClamAV clamd endpoint. Without a scanner, uploaded files stay quarantined.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Minutes a prepaid hold waits for a verified capture.
PAYMENT_HOLD_MINUTES=15
# Merchant secrets are referenced from merchant accounts as env:NAME, for example:
# RAZORPAY_KEY_SECRET_MAIN=
# RAZORPAY_WEBHOOK_SECRET_MAIN=

# ── Background workers ────────────────────────────────────────────────────────
WORKER_POLL_MS=5000
